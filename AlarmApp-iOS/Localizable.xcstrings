    "create.wake_schedule_footer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alarm Uyku kartında gösterilir. Aynı anda yalnızca bir uyanma alarmı olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This alarm appears on the Sleep card. Only one wake-up alarm at a time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette alarme apparaît sur la carte Sommeil. Une seule alarme de réveil à la fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alarma aparece en la tarjeta de Sueño. Solo una alarma de despertar a la vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот будильник показывается в карточке Сна. Одновременно только один будильник подъёма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此闹钟显示在睡眠卡片上。同一时间只能有一个起床闹钟。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر هذا المنبه في بطاقة النوم. منبه استيقاظ واحد فقط في كل مرة."
          }
        }
      }
    },
