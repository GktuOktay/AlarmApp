    "bypass.confirm_alarm": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يرن هذا المنبه في الأيام المحددة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This alarm won’t ring on the selected day(s)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alarma no sonará en el día o días seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette alarme ne sonnera pas le(s) jour(s) choisi(s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранные дни этот будильник не сработает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen gün(ler)de bu alarm çalmayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选日期将跳过此闹钟。"
          }
        }
      }
    },
