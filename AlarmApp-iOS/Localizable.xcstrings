          "stringUnit": {
            "state": "translated",
            "value": "Los grupos son opcionales. Crea uno para gestionar varias alarmas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes sont facultatifs. Créez-en un pour gérer plusieurs alarmes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы необязательны. Создайте группу, чтобы управлять несколькими будильниками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruplar isteğe bağlıdır. Birkaç alarmı birlikte yönetmek için oluştur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组为可选项，可用来一并管理多个闹钟。"
