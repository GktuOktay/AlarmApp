    "alarms.empty.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ كل منبه على حدة. يمكنك تجميعها اختياريًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create each alarm individually. Optionally group several together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea cada alarma por separado. Puedes agruparlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez chaque alarme une par une. Vous pouvez les regrouper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте каждый будильник отдельно. При желании объедините в группу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alarmı tek tek kur. İstersen birden fazlasını bir gruba bağla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐个创建闹钟，也可将多个归为一组。"
          }
        }
      }
    },
